root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{xml,yaml,yml,json}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

# Fixtures are captured from live processes - their bytes are not to be touched
[*.jsonl]
trim_trailing_whitespace = false
insert_final_newline = false

# Java
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# Written by the shade plugin next to the module POM it rewrites
dependency-reduced-pom.xml

# Python
__pycache__/
*.py[cod]
.venv/
.venv-export/
venv/
*.egg-info/

# Regenerated by make-bench-sample.ps1; audio does not belong in git history
sidecar/bench-sample.wav

# Model weights and compiled-blob caches - gigabytes; they live outside the repository.
# Directories are ignored, not extensions: banning *.bin and *.onnx would silently swallow
# any future fixture file carrying the same extension.
models/
.ov_cache/

# Personal voice artefacts: wake-word training recordings and the speaker reference.
# They must not leave the machine.
voice/
recordings/

# Working area for subagent plan execution - drafts, not history
.superpowers/

# Scratch project the manual acceptance checklist tells the reader to create.
# Recreated per run, never the same twice, and never worth committing.
testdata/sandbox/

# IDE
.idea/
.vscode/
*.iml

# Windows
Thumbs.db
desktop.ini
